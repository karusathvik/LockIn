{
  "manifest_version": 3,
  "name": "Locked In",
  "version": "1.0",
  "description": "Block distracting websites.",
  "permissions": ["storage", "declarativeNetRequest", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dynamic",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}