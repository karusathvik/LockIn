{
  "manifest_version": 3,
  "name": "Locked In",
  "version": "1.2.0",
  "description": "Block distracting websites.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "focus_logo.png"
  },
  "minimum_chrome_version": "101",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
